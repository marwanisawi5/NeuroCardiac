# NeuroCardiac Backend configuration
# Copy to .env and adjust as needed:  cp .env.example .env

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Model paths (relative to NeuroCardiacBackend/) ---
# The CNN weights are NOT committed to the repo. Train the model with
# NeuroCardiacAiModels/deep_learning_model.py and save it to this path.
BRAIN_MODEL_PATH=models/deep_learning_model.h5

# Ships with the repository — works out of the box.
HEART_MODEL_PATH=models/model_learning_model.pkl
